# Cloudflare Workers Configuration
# This file contains the configuration for Cloudflare Workers deployment

# Main API Worker
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token
CLOUDFLARE_ZONE_ID=your-zone-id

# Worker Routes
MAIN_API_WORKER=advancia-payledger-api
HEALTHCARE_AI_WORKER=advancia-healthcare-ai

# Custom Domains
MAIN_API_DOMAIN=api.advanciapayledger.com
AI_SERVICE_DOMAIN=ai.advanciapayledger.com
FRONTEND_DOMAIN=advanciapayledger.com

# Worker URLs (after deployment)
MAIN_API_URL=https://advancia-payledger-api.advancia-platform.workers.dev
HEALTHCARE_AI_URL=https://advancia-healthcare-ai.advancia-platform.workers.dev

# Environment
ENVIRONMENT=production
