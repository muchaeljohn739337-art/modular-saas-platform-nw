// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User management and authentication
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  role          UserRole  @default(PATIENT)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  patient   Patient?
  provider  Provider?
  staff     Staff?
  accounts  Account[]
  sessions  Session[]
  auditLogs AuditLog[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  ipAddress String?
  userAgent String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// Healthcare-specific models
model Patient {
  id                  String   @id @default(cuid())
  userId              String   @unique
  medicalRecordNumber String   @unique
  dateOfBirth         DateTime
  gender              Gender
  phoneNumber         String?
  address             Json?
  emergencyContact    Json?
  insuranceInfo       Json?
  medicalHistory      Json?
  allergies           Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts Account[]
  invoices Invoice[]
  payments Payment[]
  claims   Claim[]

  @@map("patients")
}

model Provider {
  id                   String   @id @default(cuid())
  userId               String   @unique
  npiNumber            String   @unique
  licenseNumber        String   @unique
  specialty            String
  practiceName         String?
  phoneNumber          String?
  address              Json?
  acceptingNewPatients Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  services Service[]
  invoices Invoice[]
  claims   Claim[]

  @@map("providers")
}

model Staff {
  id          String   @id @default(cuid())
  userId      String   @unique
  employeeId  String   @unique
  department  String
  position    String
  permissions Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff")
}

// Financial models
model Account {
  id            String      @id @default(cuid())
  userId        String
  accountNumber String      @unique
  accountType   AccountType
  balance       Decimal     @default(0.00) @db.Decimal(12, 2)
  currency      String      @default("USD")
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient   Patient?  @relation(fields: [patientId], references: [id])
  invoices  Invoice[]
  payments  Payment[]
  patientId String?

  @@map("accounts")
}

model Service {
  id          String   @id @default(cuid())
  providerId  String
  code        String // CPT/HCPCS code
  name        String
  description String?
  category    String
  price       Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  provider     Provider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  invoiceItems InvoiceItem[]

  @@map("services")
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  patientId     String
  providerId    String
  accountId     String
  totalAmount   Decimal       @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0.00) @db.Decimal(12, 2)
  balance       Decimal       @db.Decimal(12, 2)
  status        InvoiceStatus @default(DRAFT)
  dueDate       DateTime
  serviceDate   DateTime
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  patient  Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider Provider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  account  Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  items    InvoiceItem[]
  payments Payment[]
  claims   Claim[]

  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  serviceId   String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  totalAmount Decimal @db.Decimal(12, 2)
  description String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model Payment {
  id                String        @id @default(cuid())
  paymentNumber     String        @unique
  patientId         String
  invoiceId         String?
  accountId         String
  amount            Decimal       @db.Decimal(12, 2)
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  transactionId     String?       @unique
  processorResponse Json?
  processedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  patient Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  account Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Claim {
  id             String      @id @default(cuid())
  claimNumber    String      @unique
  patientId      String
  providerId     String
  invoiceId      String
  totalAmount    Decimal     @db.Decimal(12, 2)
  approvedAmount Decimal?    @db.Decimal(12, 2)
  status         ClaimStatus @default(DRAFT)
  submittedAt    DateTime?
  processedAt    DateTime?
  denialReason   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  invoice  Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("claims")
}

// Audit and compliance
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// Enums
enum UserRole {
  PATIENT
  PROVIDER
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  HEALTH_SAVINGS
  FLEXIBLE_SPENDING
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  VOID
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  ACH_TRANSFER
  CHECK
  CASH
  HEALTH_SAVINGS_ACCOUNT
  FLEXIBLE_SPENDING_ACCOUNT
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  PROCESSING
  APPROVED
  PARTIALLY_APPROVED
  DENIED
  CANCELLED
}
