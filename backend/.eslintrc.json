{
  "env": {
    "node": true,
    "es2021": true
  },
  "extends": ["eslint:recommended"],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint"],
  "rules": {
    "no-unused-vars": "off",
    "@typescript-eslint/no-unused-vars": "off",
    "no-console": "off",
    "prefer-const": "error"
  },
  "ignorePatterns": [
    "dist/**/*",
    "node_modules/**/*",
    "*.js",
    "*.mjs",
    "prisma.config.ts"
  ]
}
