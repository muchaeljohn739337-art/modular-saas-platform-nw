# Production Environment Variables - SECURE
# This file should be kept in a secure location and NOT committed to git
# Use this template and replace values with actual production secrets

# Node Environment
NODE_ENV=production
PORT=3001

# Frontend Configuration
FRONTEND_URL=https://advancia-payledger.vercel.app
NEXT_PUBLIC_API_URL=https://api.advanciapayledger.com
NEXT_PUBLIC_AI_URL=https://ai.advanciapayledger.com
NEXT_PUBLIC_ENVIRONMENT=production

# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://postgres.jwabwrcykdtpwdhwhmqq:REPLACE_WITH_ACTUAL_PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_DIRECT_URL=postgresql://postgres:REPLACE_WITH_ACTUAL_PASSWORD@db.jwabwrcykdtpwdhwhmqq.supabase.co:5432/postgres
DATABASE_POOLER_URL=postgresql://postgres.jwabwrcykdtpwdhwhmqq:REPLACE_WITH_ACTUAL_PASSWORD@aws-1-eu-central-1.pooler.supabase.com:6543/postgres

# Redis Configuration
REDIS_URL=redis://:REPLACE_WITH_ACTUAL_PASSWORD@redis-host:6379
REDIS_PASSWORD=REPLACE_WITH_ACTUAL_PASSWORD

# JWT Configuration
JWT_SECRET=REPLACE_WITH_ACTUAL_JWT_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_ACTUAL_REFRESH_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=7d

# Encryption Configuration
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTER_KEY

# Stripe Configuration
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_ACTUAL_KEY
STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_WITH_ACTUAL_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_ACTUAL_SECRET

# Email Service Configuration (SendGrid or AWS SES)
SENDGRID_API_KEY=REPLACE_WITH_ACTUAL_SENDGRID_KEY
SENDGRID_FROM_EMAIL=noreply@advanciapayledger.com

# AWS Configuration
AWS_ACCESS_KEY_ID=REPLACE_WITH_ACTUAL_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_ACTUAL_SECRET
AWS_REGION=us-east-1
AWS_S3_BUCKET=advancia-payledger-prod

# Supabase Configuration
SUPABASE_URL=https://jwabwrcykdtpwdhwhmqq.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_ACTUAL_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_ACTUAL_KEY
NEXT_PUBLIC_SUPABASE_URL=https://jwabwrcykdtpwdhwhmqq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_ACTUAL_KEY

# Vercel Configuration
VERCEL_PROJECT_ID=REPLACE_WITH_ACTUAL_ID
VERCEL_API_TOKEN=REPLACE_WITH_ACTUAL_TOKEN

# Cloudflare Configuration
CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_ACTUAL_ID
CLOUDFLARE_API_TOKEN=REPLACE_WITH_ACTUAL_TOKEN
CLOUDFLARE_ZONE_ID=REPLACE_WITH_ACTUAL_ID

# Sentry Configuration
SENTRY_DSN=REPLACE_WITH_ACTUAL_DSN
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Feature Flags
ENABLE_CRYPTO_PAYMENTS=true
ENABLE_ACH_PAYMENTS=true
ENABLE_CARD_PAYMENTS=true
ENABLE_REAL_TIME_NOTIFICATIONS=true
ENABLE_AI_FRAUD_DETECTION=true
ENABLE_AI_MEDICAL_CODING=true

# CORS Configuration
CORS_ORIGIN=https://advancia-payledger.vercel.app

# Logging
LOG_LEVEL=info
