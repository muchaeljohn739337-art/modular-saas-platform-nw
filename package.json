{"name": "advancia-pay-ledger", "version": "1.0.0", "description": "Enterprise-grade healthcare payment processing platform", "private": true, "workspaces": ["frontend", "frontend/dashboard-app", "backend", "services/*", "shared/*"], "scripts": {"dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"", "dev:frontend": "cd frontend && npm run dev", "dev:backend": "cd backend && npm run dev", "build": "npm run build:frontend && npm run build:backend", "build:frontend": "cd frontend && npm run build", "build:backend": "cd backend && npm run build", "test": "npm run test:backend && npm run test:frontend", "test:backend": "cd backend && npm run test", "test:frontend": "cd frontend && npm run test", "test:integration": "jest --config jest.integration.config.js", "test:e2e": "playwright test", "lint": "npm run lint:frontend && npm run lint:backend", "lint:frontend": "cd frontend && npm run lint", "lint:backend": "cd backend && npm run lint", "lint:fix": "npm run lint:fix:frontend && npm run lint:fix:backend", "lint:fix:frontend": "cd frontend && npm run lint:fix", "lint:fix:backend": "cd backend && npm run lint:fix", "db:migrate": "cd backend && npx supabase db push", "db:generate": "cd backend && npx supabase gen types typescript --local > src/types/supabase.ts", "db:seed": "cd backend && npm run db:seed", "docker:dev": "docker-compose -f docker-compose.dev.yml up -d", "docker:prod": "docker-compose -f docker-compose.prod.yml up -d", "docker:down": "docker-compose down", "clean": "npm run clean:frontend && npm run clean:backend && npm run clean:services", "clean:frontend": "cd frontend && rm -rf .next node_modules", "clean:backend": "cd backend && rm -rf dist node_modules", "clean:services": "cd services && find . -name \"node_modules\" -type d -exec rm -rf {} +", "setup": "npm install && npm run setup:frontend && npm run setup:backend", "setup:frontend": "cd frontend && npm install", "setup:backend": "cd backend && npm install"}, "devDependencies": {"@types/node": "^20.0.0", "@typescript-eslint/eslint-plugin": "^6.0.0", "@typescript-eslint/parser": "^6.0.0", "concurrently": "^8.2.0", "eslint": "^8.45.0", "jest": "^29.6.0", "playwright": "^1.37.0", "typescript": "^5.1.0"}, "engines": {"node": ">=18.0.0", "npm": ">=9.0.0"}, "keywords": ["healthcare", "payments", "fintech", "hipaa", "saas", "microservices"], "author": "Advancia PayLedger Team", "license": "MIT", "repository": {"type": "git", "url": "https://github.com/muchaeljohn739337-art/modular-saas-platform-nw.git"}}
